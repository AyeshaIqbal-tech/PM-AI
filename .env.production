# Production Environment Configuration
# This file contains environment variables for production deployment

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Executive Dashboard"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# API Configuration
NEXT_PUBLIC_API_URL=https://api.dashboard.com
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_TIMEOUT=10000

# Real-time Data Configuration
NEXT_PUBLIC_WS_URL=wss://api.dashboard.com/ws
NEXT_PUBLIC_SSE_URL=https://api.dashboard.com/events
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_POLLING_INTERVAL=30000

# Authentication Configuration (if applicable)
# NEXT_PUBLIC_AUTH_URL=https://auth.dashboard.com
# NEXT_PUBLIC_AUTH_CLIENT_ID=your-client-id

# Analytics and Monitoring
NEXT_PUBLIC_ANALYTICS_ID=UA-XXXXXXXXX-X
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Error Reporting
NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=https://errors.dashboard.com/api/reports
# NEXT_PUBLIC_ERROR_REPORTING_KEY=your-error-reporting-api-key

# Logging Configuration
NEXT_PUBLIC_LOGGING_ENDPOINT=https://logs.dashboard.com/api/logs
# NEXT_PUBLIC_LOGGING_API_KEY=your-logging-api-key
NEXT_PUBLIC_LOG_LEVEL=warn

# Performance Monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_CORE_WEB_VITALS_ENDPOINT=https://vitals.dashboard.com/api/metrics

# Cache Configuration
NEXT_PUBLIC_CACHE_ENABLED=true
NEXT_PUBLIC_CACHE_TTL=600000
NEXT_PUBLIC_CACHE_MAX_SIZE=104857600

# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://cdn.dashboard.com
NEXT_PUBLIC_STATIC_ASSETS_URL=https://assets.dashboard.com

# Database Configuration (server-side only, don't use NEXT_PUBLIC_)
# DATABASE_URL=postgresql://user:password@localhost:5432/dashboard
# DATABASE_POOL_SIZE=10
# DATABASE_SSL=true

# Redis Configuration (server-side only, don't use NEXT_PUBLIC_)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# Security Configuration
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_HSTS_ENABLED=true

# Feature Flags
NEXT_PUBLIC_FEATURE_REALTIME_DASHBOARD=true
NEXT_PUBLIC_FEATURE_ADVANCED_CHARTS=true
NEXT_PUBLIC_FEATURE_EXPORT_DATA=true
NEXT_PUBLIC_FEATURE_DARK_MODE=true

# Build Configuration
NEXT_PUBLIC_BUILD_ID=production-build
ANALYZE=false

# External Services
NEXT_PUBLIC_MAPS_API_KEY=your-maps-api-key
NEXT_PUBLIC_PAYMENT_GATEWAY_URL=https://payments.dashboard.com

# Notification Services
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key

# Third-party Integrations
NEXT_PUBLIC_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
NEXT_PUBLIC_TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/your/webhook/url

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_ENABLED=true
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=100
NEXT_PUBLIC_RATE_LIMIT_WINDOW=900000

# Compression and Optimization
NEXT_PUBLIC_COMPRESSION_ENABLED=true
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_LAZY_LOADING=true

# Accessibility
NEXT_PUBLIC_A11Y_ENABLED=true
NEXT_PUBLIC_HIGH_CONTRAST_MODE=false

# Internationalization (if applicable)
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr,de

# Development Tools (disabled in production)
NEXT_PUBLIC_DEVTOOLS_ENABLED=false
NEXT_PUBLIC_DEBUG_MODE=false

# Health Checks
NEXT_PUBLIC_HEALTH_CHECK_URL=https://api.dashboard.com/health
NEXT_PUBLIC_HEALTH_CHECK_INTERVAL=300000

# Backup and Recovery
NEXT_PUBLIC_BACKUP_ENABLED=true
NEXT_PUBLIC_BACKUP_INTERVAL=86400000

# Legal and Compliance
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://dashboard.com/privacy
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=https://dashboard.com/terms
NEXT_PUBLIC_COOKIE_POLICY_URL=https://dashboard.com/cookies

# Support and Documentation
NEXT_PUBLIC_SUPPORT_URL=https://support.dashboard.com
NEXT_PUBLIC_DOCS_URL=https://docs.dashboard.com
NEXT_PUBLIC_STATUS_PAGE_URL=https://status.dashboard.com

# Social Media and Branding
NEXT_PUBLIC_COMPANY_NAME="Dashboard Company"
NEXT_PUBLIC_COMPANY_URL=https://dashboard.com
NEXT_PUBLIC_SOCIAL_TWITTER=@dashboard
NEXT_PUBLIC_SOCIAL_LINKEDIN=company/dashboard